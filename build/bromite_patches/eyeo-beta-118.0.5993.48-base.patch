+  EXPECT_EQ(bigger_url.spec().size(), url::kMaxURLChars * 2);
+  EXPECT_FALSE(subscription->HasUrlFilter(bigger_url, "kindkino.ru",
+                                          ContentType::Xmlhttprequest,
+                                          SiteKey(), FilterCategory::Blocking));
