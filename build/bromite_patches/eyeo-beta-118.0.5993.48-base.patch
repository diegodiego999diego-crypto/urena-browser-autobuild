+
+function extractMutationTypes(mutations) {
+  let types = new Set();
+
+  for (let mutation of mutations) {
+    types.add(mutation.type);
+
+    // There are only 3 types of mutations: "attributes", "characterData", and
+    // "childList".
+    if (types.size == 3)
+      break;
+  }
