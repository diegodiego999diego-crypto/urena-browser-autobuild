+bool config::AllowPrivilegedFilters(const GURL& url) {
+  for (const auto& cur : GetKnownSubscriptions()) {
+    if (cur.url == url) {
+      return cur.privileged_status ==
+             SubscriptionPrivilegedFilterStatus::Allowed;
+    }
+  }
+
+  return false;
+}
