--- a/chrome/android/java/src/org/chromium/chrome/browser/firstrun/ToSAndUMAFirstRunFragment.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/firstrun/ToSAndUMAFirstRunFragment.java
@@ -95,6 +95,11 @@ public class ToSAndUMAFirstRunFragment
         mAutoUpdaterCheckBox = (CheckBox) view.findViewById(R.id.auto_updater_checkbox);
         mTosAndPrivacy = (TextView) view.findViewById(R.id.tos_and_privacy);
 
+        // Disable checking updates
+        mAutoUpdaterCheckBox.setEnabled(false);
+        mAutoUpdaterCheckBox.setVisibility(View.GONE);
+        mAutoUpdaterChecked = false;
+
         // Register event listeners.
         mAcceptButton.setOnClickListener((v) -> onTosButtonClicked());
         mAutoUpdaterCheckBox.setOnCheckedChangeListener(
