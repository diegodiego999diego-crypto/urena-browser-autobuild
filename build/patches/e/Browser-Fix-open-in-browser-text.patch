From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: althafvly <althafvly@gmail.com>
Date: Wed, 2 Oct 2024 11:41:48 +0530
Subject: Browser: Fix open in browser text

Signed-off-by: Saalim Quadri <danascape@gmail.com>
---
 .../chrome/browser/DefaultBrowserMenuUtils.java        | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/DefaultBrowserMenuUtils.java b/chrome/android/java/src/org/chromium/chrome/browser/DefaultBrowserMenuUtils.java
index 5f45e5d6b1ab511ee0faf553907475001439b7d1..ce756af13e3c04126413c1e14471bd642d3c54a7 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/DefaultBrowserMenuUtils.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/DefaultBrowserMenuUtils.java
@@ -50,8 +50,12 @@ public final class DefaultBrowserMenuUtils {
     }
 
     private static String getTitleFromPackageLabel(Context context, @Nullable String packageLabel) {
-        return packageLabel == null
-                ? context.getString(R.string.menu_open_in_product_default)
-                : context.getString(R.string.menu_open_in_product, packageLabel);
+        if (packageLabel == null) {
+            return context.getString(R.string.menu_open_in_product_default);
+        } else if ("Browser".equalsIgnoreCase(packageLabel)) {
+            return context.getString(R.string.menu_open_in_chrome);
+        } else {
+            return context.getString(R.string.menu_open_in_product, packageLabel);
+        }
     }
 }
