+++ b/components/webapk/android/libs/common/src/org/chromium/components/webapk/lib/common/WebApkConstants.java
@@ -10,4 +10,5 @@ import org.chromium.build.annotations.NullMarked;
 @NullMarked
 public final class WebApkConstants {
     public static final String WEBAPK_PACKAGE_PREFIX = "org.chromium.webapk";
+    public static final String E_WEBAPK_PACKAGE_PREFIX = "foundation.e.webapk";
 }
