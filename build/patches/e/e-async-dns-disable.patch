From 8b40cd4d3f06d39a35e0dd4baf27817dfbe70261 Mon Sep 17 00:00:00 2001
From: Romain HUNAULT <romain.hunault@e.email>
Date: Mon, 20 Jan 2020 13:34:26 +0530
Subject: [PATCH] Use default DNS settings

---
 chrome/common/chrome_features.cc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/chrome/common/chrome_features.cc b/chrome/common/chrome_features.cc
index 168d02d94de9..143178d6bea6 100644
--- a/chrome/common/chrome_features.cc
+++ b/chrome/common/chrome_features.cc
@@ -74,7 +74,7 @@ const base::Feature kAppServiceShelf{"AppServiceShelf",
 // Enables the built-in DNS resolver.
 const base::Feature kAsyncDns {
   "AsyncDns",
-#if defined(OS_CHROMEOS) || defined(OS_MACOSX) || defined(OS_ANDROID)
+#if defined(OS_CHROMEOS) || defined(OS_MACOSX)
       base::FEATURE_ENABLED_BY_DEFAULT
 #else
       base::FEATURE_DISABLED_BY_DEFAULT
