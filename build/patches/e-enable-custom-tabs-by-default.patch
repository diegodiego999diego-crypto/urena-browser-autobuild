From aaa863a7c293a05966bcf1786c2291efe4701efc Mon Sep 17 00:00:00 2001
From: Sumit Pundir <pundirsumit11@gmail.com>
Date: Fri, 10 May 2019 00:12:37 +0530
Subject: [PATCH] Enable custom tabs by default

Signed-off-by: Sumit Pundir <pundirsumit11@gmail.com>
---
 chrome/android/java/res/xml/privacy_preferences.xml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/chrome/android/java/res/xml/privacy_preferences.xml b/chrome/android/java/res/xml/privacy_preferences.xml
index 57657211111a..dc5bb4d5eb85 100644
--- a/chrome/android/java/res/xml/privacy_preferences.xml
+++ b/chrome/android/java/res/xml/privacy_preferences.xml
@@ -67,7 +67,7 @@
         android:key="allow_custom_tab_intents"
         android:title="@string/allow_custom_tab_intents_title"
         android:summary="@string/allow_custom_tab_intents_summary"
-        android:defaultValue="false" />
+        android:defaultValue="true" />
     <Preference
         android:key="sync_and_services_link_divider"
         android:layout="@layout/divider_preference"
-- 
2.17.1

