From: Romain HUNAULT <romain.hunault@e.email>
Date: Tue, 5 Feb 2019 17:01:38 +0100
Subject: [PATCH] Change package name

---
 chrome/android/BUILD.gn | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/chrome/android/BUILD.gn b/chrome/android/BUILD.gn
index cd3d4b46c39e..19fec252995c 100644
--- a/chrome/android/BUILD.gn
+++ b/chrome/android/BUILD.gn
@@ -31,8 +31,8 @@ if (modularize_vr) {
   import("//chrome/android/modules/vr/vr_module_tmpl.gni")
 }

-manifest_package = "org.chromium.chrome"
-test_manifest_package = "org.chromium.chrome.tests"
+manifest_package = "foundation.e.browser"
+test_manifest_package = "foundation.e.browser.tests"

 chrome_public_jinja_variables = default_chrome_public_jinja_variables +
                                 [ "manifest_package=$manifest_package" ]
--
