diff --git a/third_party/blink/renderer/core/dom/document.cc b/third_party/blink/renderer/core/dom/document.cc
index 77adfc54159954eb29f80356d64af202c7e2e143..427ab6d9fb052e6d37c9a000a3d7a79c846cd7e6 100644
--- a/third_party/blink/renderer/core/dom/document.cc
+++ b/third_party/blink/renderer/core/dom/document.cc
@@ -4986,9 +4986,14 @@ void Document::SetURL(const KURL& url) {
   TRACE_EVENT("blink", "Document::SetURL", perfetto::Flow::FromPointer(this),
               "url", new_url.GetString().Utf8());
 
-  // Strip the fragment directive from the URL fragment. E.g. "#id:~:text=a"
-  // --> "#id". See https://github.com/WICG/scroll-to-text-fragment.
-  new_url = fragment_directive_->ConsumeFragmentDirective(new_url);
+  // If text fragment identifiers are enabled, we strip the fragment directive
+  // from the URL fragment.
+  // E.g. "#id:~:text=a" --> "#id"
+  if (RuntimeEnabledFeatures::TextFragmentIdentifiersEnabled(domWindow())) {
+    // Strip the fragment directive from the URL fragment. E.g. "#id:~:text=a"
+    // --> "#id". See https://github.com/WICG/scroll-to-text-fragment.
+    new_url = fragment_directive_->ConsumeFragmentDirective(new_url);
+  }
 
   url_ = new_url;
   cached_outgoing_referrer_url_ = std::nullopt;
