   void OverrideDefaultSearchProvider(JNIEnv* env,
                                      const JavaParamRef<jobject>& obj);
-  void SetGoogleAsDefaultSearch(JNIEnv* env, const JavaParamRef<jobject>& obj);

   virtual ~LocaleTemplateUrlLoader();

