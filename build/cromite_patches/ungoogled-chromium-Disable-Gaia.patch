Subject: ungoogled-chromium: Disable Gaia

Disables Gaia code.
Somehow it is still being activated even without being signed-in.

See also: https://github.com/Eloston/ungoogled-chromium/issues/104

License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
Signed-off-by: Saalim Quadri <danascape@gmail.com>
---
 google_apis/gaia/gaia_auth_fetcher.cc | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/google_apis/gaia/gaia_auth_fetcher.cc b/google_apis/gaia/gaia_auth_fetcher.cc
index d0d556de9c078..e3978819ecfa5 100644
--- a/google_apis/gaia/gaia_auth_fetcher.cc
+++ b/google_apis/gaia/gaia_auth_fetcher.cc
@@ -250,6 +250,7 @@ void GaiaAuthFetcher::CreateAndStartGaiaFetcher(
     const net::NetworkTrafficAnnotationTag& traffic_annotation) {
   DCHECK(!fetch_pending_) << "Tried to fetch two things at once!";
 
+/*
   auto resource_request = std::make_unique<network::ResourceRequest>();
   resource_request->url = gaia_gurl;
   original_url_ = gaia_gurl;
@@ -308,6 +309,7 @@ void GaiaAuthFetcher::CreateAndStartGaiaFetcher(
                      base::Unretained(this)),
       // Limit to 1 MiB.
       1024 * 1024);
+*/
 }
 
 // static
