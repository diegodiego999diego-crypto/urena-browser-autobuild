@@ -347,6 +347,10 @@ by a child template that "extends" this file.
             <intent-filter>
                 <action android:name="android.intent.action.SEARCH" />
             </intent-filter>
+            <intent-filter> <!-- DOWNSTREAM -->
+                <action android:name="android.intent.action.WEB_SEARCH" />
