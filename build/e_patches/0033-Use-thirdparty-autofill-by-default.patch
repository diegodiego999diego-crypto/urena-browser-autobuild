Subject: [PATCH 33/51] Use thirdparty autofill by default

---
 .../res/layout/radio_button_group_third_party_preference.xml    | 2 +-
 .../autofill/options/RadioButtonGroupThirdPartyPreference.java  | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/chrome/browser/autofill/android/java/res/layout/radio_button_group_third_party_preference.xml b/chrome/browser/autofill/android/java/res/layout/radio_button_group_third_party_preference.xml
index 54b5038f206fe..7beb690ca1408 100644
