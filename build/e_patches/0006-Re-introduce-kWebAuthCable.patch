diff --git a/content/public/common/content_features.cc b/content/public/common/content_features.cc
index 1e0250e65829b..9c5764d26cb99 100644
--- a/content/public/common/content_features.cc
+++ b/content/public/common/content_features.cc
@@ -1140,6 +1140,13 @@ BASE_FEATURE(kWebAssemblyTrapHandler,
 #endif
 );
 
+// Controls whether CTAP2 devices can communicate via the WebAuthentication API
+// using pairingless BLE protocol.
+// https://w3c.github.io/webauthn
+BASE_FEATURE(kWebAuthCable,
+             "WebAuthenticationCable",                 // must be disabled
+             base::FEATURE_DISABLED_BY_DEFAULT);       // by default in Bromite
+
 // Controls whether the Web Bluetooth API is enabled:
 // https://webbluetoothcg.github.io/web-bluetooth/
 BASE_FEATURE(kWebBluetooth, "WebBluetooth", base::FEATURE_DISABLED_BY_DEFAULT);
