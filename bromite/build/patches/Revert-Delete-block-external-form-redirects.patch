 .../android/external_intents_features.h       |  1 +
 .../ExternalIntentsFeatures.java              |  6 ++++++
 .../ExternalNavigationHandler.java            | 21 +++++++++++++++++++
 8 files changed, 54 insertions(+), 1 deletion(-)

